# Copy this file to /etc/bepless/grpc-ingest.env and fill in your local values.
# Do not commit the real file.

# Listen on the private interface that your Tunnel-connected service can reach.
BEPLESS_GRPC_LISTEN_ADDR=127.0.0.1:50051

# Point this at the Worker ingestion endpoint.
BEPLESS_HTTP_SINK_URL=https://bepless.hawkingrei.com/ingest
BEPLESS_HTTP_SINK_TIMEOUT_SECONDS=30

# Optional. Defaults to info.
RUST_LOG=info
